      "id": 6,
      "title": "Cache Performance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(cache_gets_seconds_count{result=\"hit\"}[5m])) by (cache)",
          "legendFormat": "Hit Rate: {{cache}}",
          "refId": "A"
