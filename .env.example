# --- DATABASE CONFIG ---
# If using SQL Server on your local Windows, use 'host.docker.internal'
# If using a different DB, update the URL in docker-compose.yml
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# --- MAIL CONFIG ---
# Get an 'App Password' from your Google Account settings
SPRING_MAIL_PASSWORD=your_gmail_app_password_here

# --- SECURITY ---
# Chuoi ngau nhien dai, dung de ky JWT. Tao moi:  openssl rand -base64 48
# BAT BUOC. Thieu bien nay ung dung se khong khoi dong (StartupSecretsValidator).
JWT_SECRET=your_random_jwt_secret_here

# Tai khoan quan tri va doi tac duoc AdminSeeder dong bo lai o MOI lan khoi dong.
# Doi mat khau trong ung dung se bi ghi de khi restart -> phai doi o day.
# BAT BUOC.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
PROVIDER_EMAIL=provider@example.com
PROVIDER_PASSWORD=

# --- PAYMENT (VNPAY) ---
# Lay o sandbox.vnpayment.vn. hash-secret la thu duy nhat chung minh mot callback
# thuc su den tu cong thanh toan -> coi nhu mat khau, khong commit. BAT BUOC.
VNP_TMN_CODE=your_vnpay_tmn_code_here
VNP_HASH_SECRET=your_vnpay_hash_secret_here
# Sau moi callback bao "thanh toan thanh cong", hoi lai cong bang lenh querydr truoc khi
# giao ve. Giu true tren moi moi truong that; chi dat false khi may khong ra duoc Internet.
VNP_VERIFY_CALLBACK=true

# --- CUA THOAT HIEM CHO KHOA DA LO ---
# Backend TU CHOI KHOI DONG khi mot bi mat dang dung nam trong danh sach da lo cong khai
# (xem StartupSecretsValidator). Neu chua xoay duoc khoa va chap nhan rui ro tam thoi,
# dat true de khoi dong tiep — moi lan khoi dong se in mot khoi canh bao.
# Xoay khoa xong thi XOA bien nay di.
ALLOW_KNOWN_LEAKED_SECRETS=false

# --- AI (GEMINI) ---
# Get your API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# --- AI FALLBACK (GROQ) — TUY CHON ---
# Bo trong = tat. Khi co key, he thong tu chuyen sang Groq neu Gemini tra 429/503.
# Lay key mien phi tai https://console.groq.com
GROQ_API_KEY=

# --- FRONTEND URL (for VNPay redirect) ---
# Trên local: http://localhost:5173
# Trên AWS: https://your-domain.duckdns.org
FRONTEND_URL=http://localhost:5173
# Các tên miền frontend được phép nhận redirect sau khi VNPay trả kết quả.
# Trên môi trường deploy phải liệt kê đúng tên miền đang dùng, nếu không khách trả tiền
# xong sẽ bị đưa về tên miền cũ -> mất token trong localStorage -> văng khỏi phiên đăng nhập.
ALLOWED_FRONTEND_ORIGINS=https://vigotrip.vercel.app,https://datxe.duckdns.org,http://localhost:5173

# --- GOOGLE OAUTH2 ---
# Lấy từ: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Tạo loại "Web application", thêm Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# --- CLOUDFLARE TURNSTILE (CAPTCHA cho khách vãng lai) ---
# Bỏ trống khi dev local => CAPTCHA tắt (backend sẽ log WARN lúc khởi động).
# BẮT BUỘC cấu hình trên production, nếu không /api/chat là đường vào không kiểm soát.
# Hai khoa nay nam o HAI NOI khac nhau:
#   TURNSTILE_SECRET_KEY   -> bien moi truong cua BACKEND (Render). Bi mat.
#   VITE_TURNSTILE_SITE_KEY -> bien build-time cua FRONTEND (Vercel). Cong khai theo
#                              thiet ke, no duoc nhung thang vao bundle JS.
# Dat sai cho thi CAPTCHA khong bat: backend fail-open (verifyTurnstile tra true khi
# thieu secret) va frontend khong render widget khi thieu site key.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- RATE LIMITING ---
# Số proxy tin cậy đứng trước backend. 0 = local/trực tiếp, 1 = sau Render,
# 2 = sau Vercel rewrite -> Render. Đặt cao hơn thực tế = cho phép giả mạo IP.
APP_TRUSTED_PROXY_COUNT=0

# --- GIỚI HẠN CHI PHÍ AI ---
# Trần tổng số request AI mỗi ngày cho toàn hệ thống.
LLM_DAILY_REQUEST_CAP=2000
