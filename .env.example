# --- DATABASE CONFIG ---
# If using SQL Server on your local Windows, use 'host.docker.internal'
# If using a different DB, update the URL in docker-compose.yml
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# --- MAIL CONFIG ---
# Get an 'App Password' from your Google Account settings
SPRING_MAIL_PASSWORD=your_gmail_app_password_here

# --- SECURITY ---
# Chuoi ngau nhien dai, dung de ky JWT. Tao moi:  openssl rand -base64 48
# BAT BUOC. Thieu bien nay ung dung se khong khoi dong (StartupSecretsValidator).
JWT_SECRET=your_random_jwt_secret_here

# Tai khoan quan tri va doi tac duoc AdminSeeder dong bo lai o MOI lan khoi dong.
# Doi mat khau trong ung dung se bi ghi de khi restart -> phai doi o day.
# BAT BUOC.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
PROVIDER_EMAIL=provider@example.com
PROVIDER_PASSWORD=

# --- PAYMENT (VNPAY) ---
# Lay o sandbox.vnpayment.vn. hash-secret la thu duy nhat chung minh mot callback
# thuc su den tu cong thanh toan -> coi nhu mat khau, khong commit. BAT BUOC.
VNP_TMN_CODE=your_vnpay_tmn_code_here
VNP_HASH_SECRET=your_vnpay_hash_secret_here
# Sau moi callback bao "thanh toan thanh cong", hoi lai cong bang lenh querydr truoc khi
# giao ve. Giu true tren moi moi truong that; chi dat false khi may khong ra duoc Internet.
VNP_VERIFY_CALLBACK=true

# --- CUA THOAT HIEM CHO KHOA DA LO ---
# Backend TU CHOI KHOI DONG khi mot bi mat dang dung nam trong danh sach da lo cong khai
# (xem StartupSecretsValidator). Neu chua xoay duoc khoa va chap nhan rui ro tam thoi,
# dat true de khoi dong tiep — moi lan khoi dong se in mot khoi canh bao.
# Xoay khoa xong thi XOA bien nay di.
ALLOW_KNOWN_LEAKED_SECRETS=false

# --- AI (GEMINI) ---
# Get your API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# --- AI FALLBACK (GROQ) — TUY CHON ---
# Bo trong = tat. Khi co key, he thong tu chuyen sang Groq neu Gemini tra 429/503.
# Lay key mien phi tai https://console.groq.com
GROQ_API_KEY=

# --- BACKEND URL (dùng để nhúng ảnh QR vào mail xác nhận) ---
# Mail xác nhận nhúng mã QR bằng <img src="{BACKEND_URL}/api/public/qr/booking/{id}">.
# Client mail không hiển thị được data: URI và Brevo API không hỗ trợ Content-ID, nên ảnh
# BẮT BUỘC phải đến từ một URL công khai. Để trống trên deploy thì giá trị mặc định là
# http://localhost:8080 và khách chỉ thấy một ô ảnh vỡ ở chỗ đáng lẽ là mã check-in.
BACKEND_URL=http://localhost:8080

# --- FRONTEND URL (for VNPay redirect) ---
# Trên local: http://localhost:5173
# Trên AWS: https://your-domain.duckdns.org
FRONTEND_URL=http://localhost:5173
# Các tên miền frontend được phép nhận redirect sau khi VNPay trả kết quả.
# Trên môi trường deploy phải liệt kê đúng tên miền đang dùng, nếu không khách trả tiền
# xong sẽ bị đưa về tên miền cũ -> mất token trong localStorage -> văng khỏi phiên đăng nhập.
ALLOWED_FRONTEND_ORIGINS=https://vigotrip.vercel.app,https://datxe.duckdns.org,http://localhost:5173
# Các tên miền được phép mở WebSocket (giữ ghế thời gian thực).
# Chấp nhận ký tự đại diện vì mỗi bản deploy xem trước của Vercel lại có một tên miền mới.
# ĐỪNG đặt thành "*": kênh WebSocket từng để mở như vậy, và khi đó bất kỳ trang web nào
# cũng nhúng được vài dòng JavaScript để đọc luồng chọn ghế của người dùng.
WS_ALLOWED_ORIGIN_PATTERNS=https://vigotrip.vercel.app,https://*.vercel.app,https://datxe.duckdns.org,http://localhost:*
# Trần tần suất frame trên mỗi phiên WebSocket. RateLimitingFilter không với tới được vì
# nó là servlet filter, mà WebSocket chỉ bắt tay HTTP một lần rồi mọi frame đi trong kết
# nối đã mở. BURST phải lớn hơn số ghế tối đa chọn được một lần (mỗi ghế một frame).
WS_RATE_LIMIT_FPS=10
WS_RATE_LIMIT_BURST=40
WS_RATE_LIMIT_MAX_VIOLATIONS=20

# --- GOOGLE OAUTH2 ---
# Lấy từ: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Tạo loại "Web application", thêm Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# --- CLOUDFLARE TURNSTILE (CAPTCHA cho khách vãng lai) ---
# Bỏ trống khi dev local => CAPTCHA tắt (backend sẽ log WARN lúc khởi động).
# BẮT BUỘC cấu hình trên production, nếu không /api/chat là đường vào không kiểm soát.
#
# Hai khóa nằm ở HAI NƠI khác nhau, và CHỈ MỘT trong hai thuộc về file này:
#   TURNSTILE_SECRET_KEY    -> biến môi trường của BACKEND (Render). Bí mật. Ở ngay dưới.
#   VITE_SUPPORT_EMAIL -> địa chỉ hỗ trợ hiển thị ở footer và trang pháp lý. Mặc định
#   là support@vigotrip.vn, một hộp thư KHÔNG tồn tại (dự án không sở hữu tên miền).
#   Đặt ở my-react-app/.env.* hoặc Environment Variables của Vercel.
#
#   VITE_TURNSTILE_SITE_KEY -> biến build-time của FRONTEND. Công khai theo thiết kế (nó
#                              được nhúng thẳng vào bundle JS). KHÔNG đặt ở đây: Vite nạp
#                              env từ thư mục my-react-app/ chứ không đọc .env gốc repo,
#                              nên dòng đặt ở đây hoàn toàn vô tác dụng. Chỗ của nó là
#                              my-react-app/.env.development | .env.localapi | .env.docker
#                              | .env.production, hoặc Environment Variables trên Vercel.
#
# Lệch một bên là hỏng, và hỏng theo hai kiểu ngược nhau:
#   - thiếu secret  -> backend fail-open (verifyTurnstile trả true), CAPTCHA coi như tắt;
#   - thiếu site key nhưng CÓ secret -> frontend không render widget nên không có token,
#     backend fail-closed => khách vãng lai nhận "Captcha verification failed" ở MỌI tin
#     nhắn. Đây là lỗi đã từng xảy ra, chính vì site key bị đặt nhầm vào file này.
TURNSTILE_SECRET_KEY=

# --- RATE LIMITING ---
# Số proxy tin cậy đứng trước backend. 0 = local/trực tiếp, 1 = sau Render,
# 2 = sau Vercel rewrite -> Render. Đặt cao hơn thực tế = cho phép giả mạo IP.
APP_TRUSTED_PROXY_COUNT=0

# --- GIỚI HẠN CHI PHÍ AI ---
# Trần tổng số request AI mỗi ngày cho toàn hệ thống.
LLM_DAILY_REQUEST_CAP=2000

# --- NHẬT KÝ GIAO DỊCH ---
# Bảng nhat_ky_thanh_toan giữ nguyên văn mọi callback từ cổng, mọi lượt querydr và mọi
# quyết định hoàn tiền. Log ứng dụng không thay thế được: container restart là chứng cứ
# biến mất, mà tranh chấp tiền nong thường nổ ra sau đó vài ngày.
# Số ngày giữ lại. Dài hơn hẳn lịch sử chat (30 ngày) vì đối soát với ngân hàng và khiếu
# nại của khách đều tính bằng tháng.
PAYMENT_AUDIT_RETENTION_DAYS=180

# --- HOÁ ĐƠN NEON ---
# Neon tính tiền theo thời gian compute THỨC và tự ngủ sau 5 phút không có truy vấn. Lượt dọn
# đơn quá hạn chạy mỗi 60 giây, nên nếu nó cứ truy vấn kể cả lúc không có đơn nào thì Neon
# không bao giờ ngủ được. PendingBookingSignal cho nó ngủ theo; biến dưới đây là lưới an toàn:
# dù đang ngủ thì cứ ngần này phút vẫn quét lại một lượt, phòng khi có đường tạo đơn nào đó
# quên báo tín hiệu. Đặt 0 để tắt hẳn, quay về quét mỗi phút như trước. Xem §12 docs/THANH_TOAN_VNPAY.md.
BOOKING_CLEANUP_SAFETY_SWEEP_MINUTES=30
