{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://datxe-com.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://datxe-com.onrender.com/ws/:path*"
    },
    {
      "source": "/actuator/health",
      "destination": "https://datxe-com.onrender.com/actuator/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
