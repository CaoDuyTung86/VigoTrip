# Điểm cuối SockJS/STOMP cho bản build production.
#
# Phải trỏ THẲNG vào origin của backend, không dùng đường "/ws" đi qua rewrite của Vercel:
# rewrite của Vercel không nâng cấp được WebSocket, SockJS sẽ tụt xuống long-polling và
# kênh đó đứt/reconnect liên tục -> giữ ghế hay báo TIMEOUT.
# Xem src/context/WebSocketContext.jsx.
#
# Đổi backend thì sửa cả "/api" trong vercel.json cho khớp. Có thể ghi đè biến này ở
# Project Settings > Environment Variables trên Vercel mà không cần sửa file.
VITE_WS_URL=https://datxe-com.onrender.com/ws
